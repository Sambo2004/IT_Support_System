# ==============================================
# IT Support System - Environment Configuration
# ==============================================
# Copy this file to .env and update the values
# for your local environment.
# NEVER commit .env to version control!
# ==============================================

# Application Settings
# --------------------
# APP_NAME: Display name shown in the browser title and navbar
APP_NAME="IT Support System"

# APP_URL: Full URL to the public directory (no trailing slash)
APP_URL=http://localhost/IT_Support_System/public

# APP_ENV: development | production
# In development mode, detailed errors are shown
APP_ENV=development

# APP_DEBUG: true | false
# When true, PHP errors are displayed on screen
APP_DEBUG=true

# APP_TIMEZONE: PHP timezone identifier
# See: https://www.php.net/manual/en/timezones.php
APP_TIMEZONE=Asia/Phnom_Penh

# Database Settings
# -----------------
# DB_HOST: Database server hostname or IP
DB_HOST=localhost

# DB_PORT: Database server port (default MySQL/MariaDB: 3306)
DB_PORT=3306

# DB_DATABASE: Name of the database to use
DB_DATABASE=it_support

# DB_USERNAME: Database username
DB_USERNAME=root

# DB_PASSWORD: Database password (leave empty if no password)
DB_PASSWORD=
