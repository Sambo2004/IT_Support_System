# Root .htaccess - Redirect everything to public/ directory
# This ensures only public files are web-accessible

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect root to public/
    RewriteRule ^$ public/ [L]

    # Redirect everything else to public/
    RewriteRule (.*) public/$1 [L]
</IfModule>

# Deny access to sensitive files and directories
<FilesMatch "^\.env$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to application directories
<IfModule mod_rewrite.c>
    RewriteRule ^config/  - [F,L]
    RewriteRule ^app/     - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^storage/  - [F,L]
    RewriteRule ^resources/ - [F,L]
</IfModule>
